# --- Runtime environment ---
APP_ENV=local

# --- Core URLs (production defaults) ---
BASE_URL=https://api.zumbot.ru
PUBLIC_SITE_URL=https://zumbot.ru
GOOGLE_REDIRECT_URI=https://api.zumbot.ru/google/oauth/callback

# --- Telegram ---
MASTER_BOT_TOKEN=your-telegram-master-bot-token

# --- Database ---
DB_URL=sqlite+aiosqlite:///./mvp.db

# --- Encryption ---
ENCRYPTION_KEY=your-fernet-or-encryption-key
WEB_CONNECT_PEPPER=your-random-web-connect-pepper
WEB_CONNECT_COOKIE_NAME=zumbot_web_session

# --- Admin API auth ---
# /admin and /admin/* are enabled only when ADMIN_API_KEY is set; send it via X-API-Key header.
ADMIN_API_KEY=

# --- Google OAuth (prod should use its own OAuth client) ---
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Service settings ---
SERVICE_NAME=backend

# --- Optional config ---
SUPPORT_TG_URL=https://t.me/zumbot_support

# Planned/TODO (not wired yet in codebase)
# TIMEZONE_TTL_HOURS=6
# GOOGLE_RETRY_COUNT=3
# GOOGLE_REQUEST_TIMEOUT_SEC=5

ENABLE_READYZ=false
